{
	"name": "@idp/server",
	"type": "module",
	"scripts": {
		"dev": "wrangler dev --local",
		"build": "tsc",
		"typegen": "wrangler types",
		"generate:migrations": "drizzle-kit generate",
		"apply:migrations:local": "wrangler d1 migrations apply --local idp-db-local",
		"apply:migrations:preview": "wrangler d1 migrations apply --env preview --remote idp-db-preview",
		"apply:migrations:prod": "wrangler d1 migrations apply --env production --remote idp-db",
		"deploy:preview": "wrangler deploy --env preview",
		"deploy:prod": "wrangler deploy --env production",
		"seed": "NODE_NO_WARNINGS=1 tsx ./src/db/seed/main.ts",
		"fix": "biome check --write ./src",
		"check": "biome check ./src",
		"test:unit": "vitest --config ./vitest.config.ts",
		"test:integration": "vitest --config ./vitest.integration.config.ts"
	},
	"exports": {
		"./shared/*": {
			"import": "./dist/shared/*.js",
			"types": "./dist/shared/*.d.ts"
		}
	},
	"dependencies": {
		"@hono/valibot-validator": "^0.6.1",
		"@idp/schema": "workspace:*",
		"@octokit/auth-app": "^8.3.1",
		"@octokit/webhooks": "^14.2.0",
		"discord-api-types": "^0.38.57",
		"drizzle-orm": "^0.45.4",
		"hono": "^4.13.13",
		"octokit": "^5.0.5",
		"valibot": "^1.5.0",
		"wasm-image-optimization": "^2.0.13"
	},
	"devDependencies": {
		"@cloudflare/vitest-plugin": "^1.4.7",
		"@octokit/types": "^18.0.0",
		"@types/minimist": "^1.2.5",
		"@types/prompts": "^2.4.9",
		"drizzle-kit": "^0.31.11",
		"ics": "^3.12.1",
		"miniflare": "^4.20260730.0",
		"minimist": "^1.2.8",
		"prompts": "^2.4.2",
		"tsx": "^4.23.15",
		"typescript": "^5.9.3",
		"vitest": "^5.0.5",
		"wrangler": "^4.152.0"
	}
}
